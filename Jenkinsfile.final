pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    environment {
        APP_CONTAINER = 'library-management-api'
        APP_IMAGE = 'library-management-api'
        APP_PORT = '8082'
        SONAR_URL = 'http://localhost:9000'
        SONAR_PROJECT_KEY = 'library-management-api'
        MAVEN_TOOL = 'Maven3'
        JDK25_TOOL = 'JDK25'
        JDK21_TOOL = 'JDK21'
    }

    stages {

        stage('🔍 Preflight Validation') {
            steps {
                script {
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "📚 Library Management API - CI/CD Pipeline (Linux) - FINAL"
                    echo "👤 Lhoussaine / Hasna / Zayneb - Build ${BUILD_NUMBER}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    def missingTools = []
                    def requiredTools = [
                        [label: 'JDK 25', name: env.JDK25_TOOL],
                        [label: 'JDK 21', name: env.JDK21_TOOL],
                        [label: 'Maven', name: env.MAVEN_TOOL]
                    ]
                    requiredTools.each { t ->
                        try {
                            def resolved = tool(t.name)
                            echo "${t.label} '${t.name}' resolved at: ${resolved}"
                        } catch (Exception ex) {
                            missingTools << "${t.label} -> '${t.name}'"
                        }
                    }
                    if (missingTools) {
                        error("Missing Jenkins tools: ${missingTools.join(', ')} — Configure in Manage Jenkins > Tools")
                    }
                    try {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'PRECHECK_SONAR_TOKEN')]) {
                            echo "Credential 'sonarqube-token' OK"
                        }
                    } catch (Exception ex) {
                        error("Credential 'sonarqube-token' not found — Create as Secret text in Jenkins Credentials")
                    }
                    try { docker; echo "Docker Pipeline DSL OK" } catch (MissingPropertyException ignored) {
                        error("Docker Pipeline plugin missing")
                    }
                    try {
                        httpRequest(url: 'http://127.0.0.1:9/', httpMode: 'HEAD', timeout: 1, validResponseCodes: '100:599', quiet: true)
                        echo "HTTP Request plugin OK"
                    } catch (MissingMethodException ignored) { error("HTTP Request plugin missing") }
                      catch (NoSuchMethodError ignored) { error("HTTP Request plugin missing") }
                      catch (Exception ignored) { echo "HTTP Request plugin OK" }
                }
            }
        }

        stage('⚙️ Verify Tooling') {
            tools { jdk "${JDK25_TOOL}"; maven "${MAVEN_TOOL}" }
            steps {
                sh 'java -version'
                sh 'mvn -version'
                sh 'echo "JAVA_HOME=${JAVA_HOME}"'
            }
        }

        stage('🧪 Build and Test - Java 25') {
            tools { jdk "${JDK25_TOOL}"; maven "${MAVEN_TOOL}" }
            steps { sh 'mvn -B -ntp clean verify' }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'target/karate-reports/**'
                }
            }
        }

        stage('📊 Coverage and Static Analysis - Java 21') {
            tools { jdk "${JDK21_TOOL}"; maven "${MAVEN_TOOL}" }
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        mvn -B -ntp -Pcoverage-java21 clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:4.2.0.3121:sonar \
                          -Dsonar.host.url=$SONAR_URL \
                          -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                          -Dsonar.projectName="Library Management API" \
                          -Dsonar.token=$SONAR_TOKEN \
                          -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                    '''
                }
                // Décommenter pour bloquer si Quality Gate échoue :
                // waitForQualityGate abortPipeline: true
            }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'target/site/jacoco/**' } }
        }

        stage('🔎 Semgrep SAST Scan') {
            steps {
                sh '''
                    pip install semgrep --break-system-packages -q 2>&1 | tail -5 || pipx install semgrep -q 2>&1 | tail -5 || true
                    semgrep --version
                    semgrep --config=p/java --config=p/security-audit --config=p/owasp-top-ten \
                      --sarif --output semgrep.sarif --error || true
                    semgrep --config=p/java --config=p/security-audit --config=p/owasp-top-ten \
                      --json --output semgrep.json || true
                    python3 -c "import json; d=json.load(open('semgrep.json')); print(f\"Semgrep findings: {len(d['results'])}\"); [print(f\"  - {r['check_id']} | {r['path']}:{r['start']['line']}\") for r in d['results'][:10]]" || echo "No semgrep.json"
                '''
            }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'semgrep.json,semgrep.sarif' } }
        }

        stage('🛡️ OWASP Dependency-Check') {
            tools { jdk "${JDK21_TOOL}"; maven "${MAVEN_TOOL}" }
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                    sh '''
                        mvn org.owasp:dependency-check-maven:12.1.3:check \
                          -DnvdApiKey=$NVD_API_KEY \
                          -DprettyPrint \
                          -DfailBuildOnCVSS=7 || echo "Dependency-Check found CVEs with CVSS>=7 — check report"
                        ls -lh target/dependency-check-report.html target/dependency-check-report.json 2>&1 || echo "No report generated"
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'target/dependency-check-report.html,target/dependency-check-report.json,target/dependency-check-report.xml'
                }
            }
        }

        stage('📦 Package Artifact - Java 25') {
            tools { jdk "${JDK25_TOOL}"; maven "${MAVEN_TOOL}" }
            steps { sh 'mvn -B -ntp -DskipTests clean package' }
            post { success { archiveArtifacts artifacts: 'target/*.jar', fingerprint: true } }
        }

        stage('🐳 Build Docker Image') {
            steps {
                script {
                    def image = docker.build("${env.APP_IMAGE}:${env.BUILD_NUMBER}")
                    image.tag('latest')
                }
            }
        }

        stage('🚀 Deploy Locally') {
            steps {
                script {
                    def imageTag = "${env.APP_IMAGE}:${env.BUILD_NUMBER}"
                    def deployUrl = "http://localhost:${env.APP_PORT}/"
                    echo "Deploying ${imageTag} → ${env.APP_CONTAINER} on ${deployUrl}"
                    sh '''
                        if docker container inspect "$APP_CONTAINER" >/dev/null 2>&1; then
                          echo "Removing existing $APP_CONTAINER"
                          docker rm -f "$APP_CONTAINER"
                        fi
                    '''
                    docker.image(imageTag).run("--name ${env.APP_CONTAINER} --restart unless-stopped -d -p ${env.APP_PORT}:8080")
                    retry(20) {
                        sleep time: 3, unit: 'SECONDS'
                        def response = httpRequest(url: deployUrl, validResponseCodes: '200', quiet: true)
                        echo response.content
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'target/surefire-reports/*.xml'
            deleteDir()
        }
        success { echo "✅ Pipeline SUCCESS — All security gates passed" }
        failure { echo "❌ Pipeline FAILED — Check SonarQube/Semgrep/OWASP reports" }
    }
}
